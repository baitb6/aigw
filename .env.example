# ===== 应用 =====
AIGW_APP_NAME="AI 聚合网关"
AIGW_APP_DEBUG=false
# 对外访问地址（带协议，结尾不带斜杠）
AIGW_APP_URL=http://your-domain.com
# 凭据加密主密钥：格式 base64:<32 字节随机>
# 生成：php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# 一旦录入账号就不可更换，否则历史凭据全部解不开
AIGW_APP_KEY=
# 管理台登录入口，改成不易猜到的值可降低扫描爆破
AIGW_ADMIN_LOGIN_PATH=/api/admin/login
AIGW_CORS_ORIGINS=

# ===== 数据库 =====
AIGW_DB_HOST=127.0.0.1
AIGW_DB_PORT=3306
AIGW_DB_DATABASE=ai_com
AIGW_DB_USERNAME=ai_com
AIGW_DB_PASSWORD=

# ===== 网关 =====
AIGW_GATEWAY_PORT=51120
AIGW_GATEWAY_BASE_URL=http://your-domain.com
AIGW_TRUSTED_PROXIES=
# CDN 回源口令：openssl rand -hex 32
AIGW_ORIGIN_TOKEN=
AIGW_ORIGIN_TOKEN_HEADER=x-aigw-origin-token
AIGW_CLIENT_IP_HEADER=eo-connecting-ip
# 允许自定义供应商指向内网地址（会削弱 SSRF 防护，默认关闭）
AIGW_ALLOW_PRIVATE_UPSTREAM=

# ===== 异步任务与验证码求解（可选）=====
AIGW_PHP_BIN=
AIGW_NODE_BIN=
AIGW_BROWSER_BIN=
AIGW_CAPTCHA_HEADLESS=0
AIGW_XVFB_DISPLAY=

# ===== 供应商专用（按需填写）=====
AIGW_ANTIGRAVITY_CLIENT_ID=
AIGW_ANTIGRAVITY_CLIENT_SECRET=

# ===== 安装脚本（可选）=====
AIGW_INSTALL_ADMIN_USERNAME=admin
AIGW_INSTALL_ADMIN_PASSWORD=
# 已有业务数据的库上执行 install.php --force 时才需要
AIGW_ALLOW_DESTRUCTIVE=
